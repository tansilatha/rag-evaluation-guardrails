# Keep locally generated source-corpus and retrieval artifacts out of Git.
/data/*
!/data/README.md

# Evaluation datasets and generated golden data stay local pending provenance review.
/datasets/*
!/datasets/goldens/
/datasets/goldens/*
!/datasets/goldens/README.md

# Keep raw reports local; allow only the reviewed aggregate summary.
/reports/*
!/reports/final_rag_evaluation_report.md
!/reports/public/
/reports/public/*
!/reports/public/README.md

# Model weights, tokenizer files, and local model configuration are not
# redistributed until their licenses and provenance have been confirmed.
/models/**
!/models/README.md

